# AI Career Navigator — environment variables
# Copy this file to .env.local and fill in the values from your Team Lead / Supabase project settings.
# Vite only exposes variables prefixed with VITE_ to client code (see vite.config.ts / import.meta.env).
#
# NOTE: creating this file alone is not enough to run the app. You also need:
#   1. A Supabase project (new or shared) with the schema from supabase/migrations/ applied
#   2. A "resumes" storage bucket
#   3. Edge functions deployed (supabase functions deploy)
# See the "Local Setup" section in README.md for the full walkthrough.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key